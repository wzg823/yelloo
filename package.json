{
  "name": "bbs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:trust": "node scripts/test-trust.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "build:image": "wsl -d Ubuntu -u root -- bash \"/mnt/e/dsh project bbs/scripts/build-image.sh\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.2",
    "next": "^15.4.0",
    "pg": "^8.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
