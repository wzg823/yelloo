# ── 数据库 ────────────────────────────────────────────────────────────────
# 本机开发（docker compose 起 postgres 时用 127.0.0.1）
DATABASE_URL=postgres://bbs:bbs@127.0.0.1:5432/bbs

# 是否启用 SSL。留空 = 自动判断：
#   主机是内网名（localhost / 127.0.0.1 / postgres / db / host.docker.internal）
#     → 关闭（容器内 Postgres 默认不支持 SSL）
#   其余（云数据库域名或公网 IP）
#     → 开启
# 仅当自动判断与实际不符时才显式设置 true / false。
# 注意：不要用主机名子串去猜网络拓扑——compose 内部连的是服务名 postgres，
# 曾经因为只判断 localhost 而导致迁移报 "does not support SSL connections"。
# DATABASE_SSL=false

# ── 站点 ──────────────────────────────────────────────────────────────────
# SITE_ADDRESS 是 Caddy 的站点地址，同时决定 TLS 行为：
#   已备案域名       → SITE_ADDRESS=bbs.example.com
#                      Caddy 自动申请并续期 Let's Encrypt 证书
#   无域名的验证机   → SITE_ADDRESS=:80
#                      纯 HTTP，不启用 TLS（没有证书警告，适合 SSH 隧道调试）
# ⚠️ 有域名后必须改回域名，否则登录凭证走明文
SITE_ADDRESS=bbs.example.com

# 中国大陆部署：必须使用已备案域名，且此值与实际访问域名完全一致
# 用于：cookie secure 判断、OG 标签、sitemap、canonical
SITE_URL=https://bbs.example.com
SITE_NAME=技术社区
# 客户端组件（侧栏标题）读不到 SITE_NAME，必须单独提供一个 NEXT_PUBLIC_ 变量。
# 改站点名时两个都要改。
NEXT_PUBLIC_SITE_NAME=技术社区

# ── 会话 ──────────────────────────────────────────────────────────────────
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=请替换为48字节随机串

# 会话 Cookie 的 Secure 标志。留空 = 跟随 NODE_ENV（生产为 true，这是正确默认）。
# 仅当通过 **纯 HTTP** 访问生产模式时才需要设为 false，典型场景是用 SSH 隧道
# 在 http://localhost:3000 上验证部署 —— 否则浏览器不发送 Secure Cookie，
# 表现为"登录成功但立刻又变成未登录"。
# ⚠️ 任何走 HTTPS 的环境都必须留空或设为 true。
# COOKIE_SECURE=false

# ── Snowflake ID ──────────────────────────────────────────────────────────
# 自定义纪元（毫秒）。默认 2024-01-01T00:00:00Z。
# 一旦上线并有数据，禁止再修改，否则 ID 会失去单调性。
SNOWFLAKE_EPOCH=1704067200000
# 多实例部署时每个实例必须不同（0-1023）
SNOWFLAKE_WORKER_ID=1

# ── 上传 ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./var/uploads
# 单文件上限（字节），默认 8MiB
UPLOAD_MAX_BYTES=8388608

# ── Postgres 内存参数（按机器规格调，否则小机器会 OOM）────────────────────
# 经验值：shared_buffers ≈ 内存的 15~25%，effective_cache_size ≈ 50~75%
#
#   2C4G（默认，可不设）：256MB / 768MB / 8MB / 100
#   2C2G 及以下：        96MB  / 256MB / 4MB / 50
#   4C8G：              1GB   / 3GB   / 16MB / 150
#
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB
# PG_WORK_MEM=8MB
# PG_MAX_CONNECTIONS=100

# ── 应用连接池 ────────────────────────────────────────────────────────────
# 必须满足：DATABASE_POOL_MAX × 应用实例数 + 余量 < PG_MAX_CONNECTIONS
DATABASE_POOL_MAX=10

# ── 实时（SSE）─────────────────────────────────────────────────────────────
# 心跳间隔，必须小于所有中间层的读超时（Caddyfile 配了 flush_interval -1 与 60s 读超时）
SSE_HEARTBEAT_MS=25000
# 单用户最大并发 SSE 连接数（多标签页）
SSE_MAX_CONNS_PER_USER=3
# 单连接积压事件上限，超限下发 resync 让客户端重拉
SSE_MAX_BACKLOG=500

# ── 端到端验证（scripts/smoke.mjs）──────────────────────────────────────────
# smoke 脚本用两个**长期固定的账号**（smokea / smokeb）模拟两个浏览器，
# 先尝试登录、失败才注册。它们的口令必须由环境提供，不能写死在源码里：
# 写死等于把一把长期有效的钥匙提交进版本库，仓库转公开或加协作者时就泄露了。
#
# 生成一个随机口令（不要复用 SESSION_SECRET）：
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# 不设置时 smoke 会以退出码 2 报"缺少 SMOKE_PASSWORD"，不会静默跳过验证。
# ⚠️ 首次配置后跑一次 smoke，它会自动注册这两个账号；之后每次跑都是登录。
SMOKE_PASSWORD=
